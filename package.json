    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.0",
    "morgan": "^1.12.0",
    "uuid": "^9.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/argon2": "^0.14.1",
    "@types/body-parser": "^1.19.6",
